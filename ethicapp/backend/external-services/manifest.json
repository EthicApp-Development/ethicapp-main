{
  "services": [
    {
      "id": "mock-ai-response-review",
      "description": "PoC adapter that simulates an AI service reviewing student responses.",
      "adapter": "./adapters/mock-ai-response-review.adapter.js",
      "development": true,
      "requires": [],
      "hooks": [
        "student-response-submitted",
        "phase-started",
        "phase-ended",
        "chat-message-received",
        "callback-received"
      ],
      "scopes": ["response", "chat"],
      "callbackAuth": {
        "allowedClientIds": ["ethicapp-external-mock"],
        "requiredRoles": []
      }
    },
    {
      "id": "mock-chat-agent",
      "description": "PoC adapter that simulates a chat agent replying to group chat messages.",
      "adapter": "./adapters/mock-chat-agent.adapter.js",
      "development": true,
      "requires": [],
      "hooks": [
        "chat-message-received"
      ],
      "scopes": ["chat"],
      "callbackAuth": {
        "allowedClientIds": ["ethicapp-external-mock"],
        "requiredRoles": []
      }
    },
    {
      "id": "polyadic-devils-advocate",
      "description": "Bridge adapter that connects EthicApp group chats to the Polyadic Agents Devil's Advocate pipeline.",
      "adapter": "./adapters/polyadic-bridge.adapter.js",
      "requires": ["polyadic-agent"],
      "hooks": [
        "chat-message-received",
        "phase-started",
        "phase-ended",
        "callback-received",
        "activity-finished"
      ],
      "scopes": ["chat"],
      "descriptor": {
        "path": "/polyadic-agent/api/capabilities"
      },
      "callbackAuth": {
        "allowedClientIds": ["polyadic-agent-api"],
        "requiredRoles": []
      }
    },
    {
      "id": "argumentation-tutor-system",
      "description": "ATS integration using Keycloak-protected V2 endpoints for argument feedback in student chat overlay.",
      "adapter": "./adapters/ats-feedback.adapter.js",
      "requires": ["argumentation-tutor"],
      "hooks": [
        "student-response-submitted",
        "phase-ended",
        "callback-received"
      ],
      "scopes": ["response"],
      "descriptor": {
        "path": "/argumentation-tutor/api/capabilities"
      },
      "callbackAuth": {
        "allowedClientIds": ["argumentation-tutor-api"],
        "requiredRoles": []
      }
    },
    {
      "id": "case-analyst",
      "description": "Skeleton adapter for the Case Analyst AI service; acknowledges newly created cases.",
      "adapter": "./adapters/case-analyst.adapter.js",
      "requires": ["case-analyst"],
      "hooks": [
        "case-created",
        "callback-received"
      ],
      "scopes": ["case"],
      "callbackAuth": {
        "allowedClientIds": ["case-analyst-api"],
        "requiredRoles": []
      }
    },
    {
      "id": "mock-case-analysis",
      "description": "Development adapter that analyses case documents in process: word count and an excerpt.",
      "adapter": "./adapters/mock-case-analysis.adapter.js",
      "development": true,
      "requires": [],
      "hooks": [
        "case-created"
      ],
      "scopes": ["case"],
      "ui": { "component": "mock-case-analysis" },
      "callbackAuth": {
        "allowedClientIds": ["ethicapp-external-mock"],
        "requiredRoles": []
      }
    },
    {
      "id": "mock-design-analysis",
      "description": "Development adapter that analyses designs in process: counts the phases and questions that use the Argumentation Tutor.",
      "adapter": "./adapters/mock-design-analysis.adapter.js",
      "development": true,
      "requires": [],
      "hooks": [
        "design-saved"
      ],
      "scopes": ["design"],
      "callbackAuth": {
        "allowedClientIds": ["ethicapp-external-mock"],
        "requiredRoles": []
      }
    }
  ]
}
