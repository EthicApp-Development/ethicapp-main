ETHICAPP_NODE_PORT=8501
NODE_ENV=development
ETHICAPP_SESSION_COOKIE_NAME=ethicapp.sid
ETHICAPP_SESSION_COOKIE_SAMESITE=lax
ETHICAPP_SESSION_COOKIE_SECURE=false
ETHICAPP_SESSION_COOKIE_MAX_AGE_MS=86400000
ETHICAPP_SESSION_TTL_SECONDS=86400
ETHICAPP_SESSION_REDIS_PREFIX=ethicapp:sess:
AI_ADDITIONS_BASE_URL=http://host.docker.internal:8010
AI_ADDITIONS_HTTP_TIMEOUT_MS=12000
AI_ADDITIONS_KEYCLOAK_BASE_URL=http://host.docker.internal:8010/keycloak
AI_ADDITIONS_KEYCLOAK_REALM=ethicapp-ai-additions
AI_ADDITIONS_KEYCLOAK_CLIENT_ID=ethicapp-platform
AI_ADDITIONS_KEYCLOAK_CLIENT_SECRET=replace_with_real_secret
AI_ADDITIONS_KEYCLOAK_TOKEN_URL=
AI_ADDITIONS_KEYCLOAK_SCOPE=
AI_ADDITIONS_ARGUMENTATION_TUTOR_API_BASE_URL=http://host.docker.internal:8010/argumentation-tutor/api/v2
AI_ADDITIONS_ARGUMENTATION_TUTOR_POLL_INTERVAL_MS=2500
AI_ADDITIONS_ARGUMENTATION_TUTOR_POLL_TIMEOUT_MS=90000
AI_ADDITIONS_POLYADIC_AGENTS_API_BASE_URL=http://host.docker.internal:8010/polyadic-agent/api
AI_ADDITIONS_POLYADIC_AGENTS_AUTHENTICATED=true
AI_ADDITIONS_POLYADIC_AGENTS_PIPELINE_TYPE=abogado-del-diablo
EXTERNAL_MOCK_SERVICE_URL=http://external-mock-service:8510
EXTERNAL_SERVICES_MANIFEST=/app/backend/external-services/manifest.json
EXTERNAL_SERVICES_CALLBACK_AUTH_ENABLED=true
EXTERNAL_SERVICES_CALLBACK_AUTH_ISSUER=http://host.docker.internal:8010/keycloak/realms/ethicapp-ai-additions
EXTERNAL_SERVICES_CALLBACK_AUTH_JWKS_URL=
EXTERNAL_SERVICES_CALLBACK_AUTH_AUDIENCE=ethicapp-ai-services
EXTERNAL_SERVICES_CALLBACK_AUTH_CLOCK_TOLERANCE_SECONDS=30
ETHICAPP_PROCESS_ROLE=web
ETHICAPP_SEED_CANONICAL_ACTIVITIES=true
ETHICAPP_SEED_CANONICAL_ACTIVITIES_ATTEMPTS=12
ETHICAPP_SEED_TAG_TAXONOMIES=true
ETHICAPP_SEED_TAG_TAXONOMIES_ATTEMPTS=12
ETHICAPP_TAG_TAXONOMY_SEED_DIR=/database/seeds/tag-taxonomies
UPLOADS_PATH=/app/backend/uploads
PDF_RENDER_WORKER_CONCURRENCY=1
PDF_RENDER_WORKER_POLL_INTERVAL_MS=2000
PDF_RENDER_DPI=200
PDF_RENDER_MAX_PAGES=50
PDF_RENDER_TIMEOUT_MS=120000
