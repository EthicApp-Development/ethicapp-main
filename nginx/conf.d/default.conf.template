map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Classifies a request as a page navigation or an API call, so that auth and
# upstream failures can answer API clients with JSON instead of HTML.
# Sec-Fetch-Mode decides when present; Sec-Fetch-Dest and then Accept cover
# clients that do not send it.
map $http_accept $ethicapp_accept_request_kind {
    default       api;
    "~*text/html" navigation;
}

map $http_sec_fetch_dest $ethicapp_dest_request_kind {
    ""       $ethicapp_accept_request_kind;
    document navigation;
    default  api;
}

map $http_sec_fetch_mode $ethicapp_request_kind {
    ""       $ethicapp_dest_request_kind;
    navigate navigation;
    default  api;
}

# Keeps a well-formed request id set by a proxy in front of NGINX and
# generates one otherwise. Sent to upstreams and returned to clients.
map $http_x_request_id $ethicapp_request_id {
    default                    $request_id;
    "~^[A-Za-z0-9._-]{8,128}$" $http_x_request_id;
}

log_format ethicapp_edge '$remote_addr [$time_iso8601] "$request" $status $body_bytes_sent '
                         'request_id=$ethicapp_request_id kind=$ethicapp_request_kind '
                         'auth_status=$auth_check_status user_id=$auth_user_id '
                         'upstream_status=$upstream_status upstream_time=$upstream_response_time '
                         'request_time=$request_time forwarded_for="$http_x_forwarded_for" '
                         'user_agent="$http_user_agent"';

server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;

    set $ethicapp_backend ethicapp:${ETHICAPP_NODE_PORT};
    set $auth_backend auth-backend:${PORT};
    set $ethicapp_student_backend ethicapp-student:${ETHICAPP_STUDENT_NODE_PORT};
    set $management_console_backend management-console:${MNG_PORT};

    absolute_redirect off;
    client_max_body_size 20m;

    access_log /var/log/nginx/access.log ethicapp_edge;

    # Inherited only by locations that declare no add_header or error_page of
    # their own; protected locations repeat them.
    add_header X-Request-Id $ethicapp_request_id always;
    error_page 500 502 503 504 /_errors/unavailable;

    # ---------------------------------------
    # Shared public font assets
    # ---------------------------------------
    location ^~ /static/fonts/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ^~ /auth/static/fonts/ {
        alias /usr/share/nginx/html/static/fonts/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ^~ /student/static/fonts/ {
        alias /usr/share/nginx/html/static/fonts/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ^~ /mng/static/fonts/ {
        alias /usr/share/nginx/html/static/fonts/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # ---------------------------------------
    # Shared public favicon assets
    # ---------------------------------------
    location ^~ /favicon/ {
        alias /usr/share/nginx/html/static/favicon/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ~ ^/(auth|student|mng)/favicon/(.+)$ {
        alias /usr/share/nginx/html/static/favicon/$2;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ~ ^/(auth|student|mng)/(favicon\.ico|favicon\.svg|apple-touch-icon\.png|site\.webmanifest)$ {
        alias /usr/share/nginx/html/static/favicon/$2;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ^~ /auth/favicon/ {
        alias /usr/share/nginx/html/static/favicon/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location = /auth/favicon.ico {
        alias /usr/share/nginx/html/static/favicon/favicon.ico;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location = /auth/favicon.svg {
        alias /usr/share/nginx/html/static/favicon/favicon.svg;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location = /auth/apple-touch-icon.png {
        alias /usr/share/nginx/html/static/favicon/apple-touch-icon.png;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location = /auth/site.webmanifest {
        alias /usr/share/nginx/html/static/favicon/site.webmanifest;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ^~ /mng/favicon/ {
        alias /usr/share/nginx/html/static/favicon/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location = /mng/favicon.ico {
        alias /usr/share/nginx/html/static/favicon/favicon.ico;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location = /mng/favicon.svg {
        alias /usr/share/nginx/html/static/favicon/favicon.svg;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location = /mng/apple-touch-icon.png {
        alias /usr/share/nginx/html/static/favicon/apple-touch-icon.png;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location = /mng/site.webmanifest {
        alias /usr/share/nginx/html/static/favicon/site.webmanifest;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ~ ^/(favicon\.ico|favicon\.svg|apple-touch-icon\.png|site\.webmanifest)$ {
        alias /usr/share/nginx/html/static/favicon/$1;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # ---------------------------------------
    # Shared public logo assets
    # ---------------------------------------
    location ^~ /images/logos/ {
        alias /usr/share/nginx/html/static/logos/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ^~ /assets/images/logos/ {
        alias /usr/share/nginx/html/static/logos/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location ~ ^/(auth|student|mng)/(images|assets/images)/logos/(.+)$ {
        alias /usr/share/nginx/html/static/logos/$3;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # ---------------------------------------
    # Auth SPA publica
    # Canonical base: /auth
    # ---------------------------------------
    location = / {
        return 302 /auth/;
    }

    location = /auth {
        return 302 /auth/;
    }

    # Backward-compatible redirects for old bare auth routes.
    location ~ ^/(login|logout|register|forgot|reset-password|privacy|terms)$ {
        return 302 /auth$uri$is_args$args;
    }

    location ^~ /auth/assets/ {
        rewrite ^/auth(/assets/.*)$ $1 break;
        proxy_pass http://$auth_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;
    }

    location = /auth/runtime-config.js {
        rewrite ^/auth/runtime-config\.js$ /runtime-config.js break;
        proxy_pass http://$auth_backend;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store";
        add_header X-Request-Id $ethicapp_request_id always;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;
    }

    location ^~ /auth/ {
        rewrite ^/auth/.*$ / break;
        proxy_pass http://$auth_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;
    }

    # ---------------------------------------
    # Auth API pública
    # ---------------------------------------
    location /api/auth/ {
        proxy_pass http://$auth_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;
    }

    # ---------------------------------------
    # Endpoint interno para auth_request
    # ---------------------------------------
    location = /_auth_check {
        internal;

        proxy_pass http://$auth_backend/auth/session/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";

        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;
        proxy_set_header Cookie $http_cookie;
    }

    auth_request_set $auth_user_id $upstream_http_x_user_id;
    auth_request_set $auth_user_role $upstream_http_x_user_role;
    auth_request_set $auth_session_cookie $upstream_http_set_cookie;
    auth_request_set $auth_check_status $upstream_status;

    # ---------------------------------------
    # Student app (protected)
    # ---------------------------------------
    location = /student/runtime-config.js {
        proxy_pass http://$ethicapp_student_backend;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store";
        add_header X-Request-Id $ethicapp_request_id always;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;
    }

    location /student/api/ {
        auth_request /_auth_check;
        error_page 401 = @auth_redirect;
        error_page 500 502 503 504 /_errors/unavailable;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;

        proxy_pass http://$ethicapp_student_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
    }

    location /student/ {
        auth_request /_auth_check;
        error_page 401 = @auth_redirect;
        error_page 500 502 503 504 /_errors/unavailable;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;

        proxy_pass http://$ethicapp_student_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
    }

    # ---------------------------------------
    # Estáticos públicos de EthicApp
    # ---------------------------------------
    location /uploads/ {
        auth_request /_auth_check;
        error_page 401 = @auth_redirect;
        error_page 500 502 503 504 /_errors/unavailable;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;

        proxy_pass http://$ethicapp_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
    }

    # ---------------------------------------
    # WebSockets de EthicApp
    # ---------------------------------------
    location /socket.io/ {
        auth_request /_auth_check;
        error_page 401 = @auth_redirect;
        error_page 500 502 503 504 /_errors/unavailable;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;

        proxy_pass http://$ethicapp_backend;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;

        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }

    location = /mng {
        return 302 /mng/;
    }

    # ---------------------------------------
    # Management Console (protected + role S)
    # ---------------------------------------
    location ^~ /mng/ {
        auth_request /_auth_check;
        error_page 401 = @auth_redirect;
        error_page 403 = @forbidden;
        error_page 500 502 503 504 /_errors/unavailable;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;

        proxy_pass http://$management_console_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
    }

    # The "back to management console" form in ethicapp ends the admin's own
    # impersonation (#721). Ending it only drops privileges, so this one
    # endpoint is served at the edge, behind the usual session check.
    location = /api/admin/impersonation/stop {
        auth_request /_auth_check;
        error_page 401 = @auth_redirect;
        error_page 500 502 503 504 /_errors/unavailable;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;

        proxy_pass http://$ethicapp_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
    }

    # The rest of ethicapp's /api/admin/ (starting a teacher impersonation) is
    # called only by management-console over the internal network, after its
    # own step-up check. It is never served at the edge.
    location ^~ /api/admin/ {
        add_header X-Request-Id $ethicapp_request_id always;
        return 404;
    }

    # ======================================
    # EXTERNAL SERVICES CALLBACKS (service-to-service, no browser session)
    # ======================================
    location /external-services/ {
        proxy_pass http://$ethicapp_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;

        # Callbacks authenticate on their own. Never let a client choose the
        # identity that hydrateLegacySession builds the ethicapp session from.
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Role "";
    }

    # ---------------------------------------
    # Todo lo demás: EthicApp protegido
    # ---------------------------------------
    location / {
        auth_request /_auth_check;
        error_page 401 = @auth_redirect;
        error_page 500 502 503 504 /_errors/unavailable;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;

        proxy_pass http://$ethicapp_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Request-Id $ethicapp_request_id;

        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
    }

    # Missing or expired session. Page navigations go to sign-in; API calls get
    # a JSON 401 they can act on, because browsers follow a redirect silently
    # and would hand the login page HTML to the caller. Set-Cookie forwards the
    # cookie that auth-backend clears when it expires a session.
    location @auth_redirect {
        # Empty types: the URI extension (for example .png) must not set the
        # Content-Type of the JSON body.
        types { }
        default_type application/json;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;
        add_header Cache-Control "no-store" always;

        if ($ethicapp_request_kind = api) {
            return 401 '{"status":"expired"}';
        }

        return 302 /auth/login;
    }

    # Errors generated by NGINX itself: an upstream that is down or times out,
    # or an auth check that fails. Responses produced by an upstream pass
    # through unchanged because proxy_intercept_errors stays off. error_page
    # points here with a URI and without "=", so NGINX keeps the original
    # 5xx status and turns the method into GET; the static page below can
    # then answer POST navigations such as form submissions.
    location = /_errors/unavailable {
        internal;
        types { }
        default_type application/json;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;
        add_header Cache-Control "no-store" always;

        if ($ethicapp_request_kind = navigation) {
            rewrite ^ /_errors/unavailable.html last;
        }

        return 200 '{"status":"unavailable"}';
    }

    # Readable page for navigations that hit /_errors/unavailable. The
    # internal redirect keeps the original 5xx status.
    location = /_errors/unavailable.html {
        internal;
        alias /usr/share/nginx/html/static/errors/unavailable.html;
        add_header Set-Cookie $auth_session_cookie always;
        add_header X-Request-Id $ethicapp_request_id always;
        add_header Cache-Control "no-store" always;
        sub_filter '__REQUEST_ID__' $ethicapp_request_id;
        sub_filter_once off;
    }

    location @forbidden {
        add_header X-Request-Id $ethicapp_request_id always;
        return 403;
    }
}
