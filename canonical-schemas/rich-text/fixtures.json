      "tree": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Primera línea."
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "Segunda línea."
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "value": "Tercera, tras una línea vacía."
            }
          ]
        }
